# Supabase (shared — backend uses service role, frontend uses anon key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SITE_URL=https://www.statusmarket.store
# Free tier key from https://aistudio.google.com/apikey — powers AI caption/description generation
GEMINI_API_KEY=

# Frontend (Vite needs VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000
VITE_SITE_URL=https://www.statusmarket.store
